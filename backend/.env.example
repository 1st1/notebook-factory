APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Use a Neon/Vercel Marketplace Postgres URL on Vercel. Local default is SQLite.
DATABASE_URL=
# Sandbox uses Vercel OIDC on deployments. Locally: vercel env pull, or set these:
# VERCEL_OIDC_TOKEN=
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# Optional public Blob store for published HTML; absent locally uses database HTML.
BLOB_READ_WRITE_TOKEN=
# AI chat uses Vercel AI Gateway via deployment OIDC (or this optional local key).
# AI_GATEWAY_API_KEY=
# AI_MODEL=gateway:anthropic/claude-sonnet-4.6
